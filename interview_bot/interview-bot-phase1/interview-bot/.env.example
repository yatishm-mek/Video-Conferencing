# Copy to .env and edit. Every key is optional; defaults live in interview_bot/config.py.

HOST=127.0.0.1
PORT=7860
LOG_LEVEL=DEBUG
# Opt-in deep tracing: writes logs/debug.log + [trace] lines + JSON snapshots
# under logs/debug/. Off by default (no behaviour change). Set true to debug a run.
DEBUG_TRACE=false

# --- STT: local (faster-whisper) or groq ---
STT_PROVIDER=local
STT_LANGUAGE=en
WHISPER_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
WHISPER_DEVICE=auto
# int8 on CPU. With an NVIDIA GPU, int8_float16 is faster.
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1
WHISPER_NO_SPEECH_PROB=0.4
# Drop segments Whisper is unsure of (noise, echo, other languages)
WHISPER_MIN_AVG_LOGPROB=-1.0
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
STT_VOCAB=LoRA, PyTorch, CTC, WER, Whisper, fine-tuning, transformer, BM25

# --- VAD / turn-taking ---
VAD_CONFIDENCE=0.7
VAD_START_SECS=0.2
VAD_STOP_SECS=0.2
VAD_MIN_VOLUME=0.6
BARGE_IN_MIN_SECS=0.5
# Sustained speech this long cuts the bot without waiting for words
BARGE_IN_HARD_SECS=1.2
EARLY_BARGE_IN_WINDOW_SECS=0.3

# --- TTS ---
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0

# --- LLM (Ollama) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 4096 keeps qwen3.5:9b 100% on the 8 GB RTX 5050
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=-1
# Live bot: if the server log warns about CPU, switch to qwen3.5:4b
LIVE_LLM_MODEL=qwen3.5:9b
LIVE_LLM_TEMPERATURE=0.4
LIVE_LLM_MAX_TOKENS=80
LLM_FIRST_TOKEN_TIMEOUT_SECS=4
PREP_LLM_MODEL=qwen3.5:9b
PREP_NUM_CTX=8192
PREP_THINK=false
PREP_NUM_QUESTIONS=6
PREP_MAX_TOKENS=6000
# Evaluator: llm = Qwen judges each answer; rules = accept every answer (no LLM)
EVALUATOR=llm
EVAL_TEMPERATURE=0.1
EVAL_MAX_TOKENS=260

# --- Interview ---
# interview = Qwen asks the plan's questions; echo = Phase 1 audio test
BOT_MODE=interview
# natural (one LLM turn per reply) or classic (4 prompts + fixed replies), for A/B tests
BOT_ENGINE=natural
NATURAL_TEMPERATURE=0.5
NATURAL_MAX_TOKENS=150
NATURAL_RESCUE_SECS=1.8
NATURAL_RESCUE_EVERY_TURNS=3
NATURAL_TURN_TIMEOUT_SECS=5
NATURAL_MODE=llm
NATURAL_SILENCE_PROMPT_SECS=5
NATURAL_SILENCE_MOVE_ON_SECS=25
MAX_REPEATS_PER_QUESTION=2
MAX_GO_BACKS_PER_INTERVIEW=1
MAX_IDLE_TURNS_PER_QUESTION=4
MAX_END_CHECKS_PER_INTERVIEW=2
SCORE_MAX_TOKENS=300
INTERVIEW_PLAN_PATH=data/sample_plan.json

# --- Controller timers (seconds). Shorten them to test, e.g. EXTENDED_WAIT_SECS=8 ---
NO_SPEECH_PROMPT_SECS=5
NEED_TIME_REPLY_SECS=6
EXTENDED_WAIT_SECS=25
INCOMPLETE_PROMPT_SECS=5
EVALUATOR_FILLER_SECS=0.8
EVALUATOR_TIMEOUT_SECS=5
MAX_ANSWER_SECS=180
MAX_CONFIRMATIONS_PER_INTERVIEW=3
# Re-checking a doubtful claim: 1 per question, this many per interview
MAX_VERIFICATIONS_PER_INTERVIEW=3
# Earlier Q/A the evaluator sees (questions, words per answer)
EVAL_HISTORY_QUESTIONS=4
EVAL_HISTORY_WORDS=60
INTERVIEW_TIME_LIMIT_SECS=1200
READY_REPROMPT_SECS=12
# After a long answer (HOLD_MIN_WORDS+ words), wait this much silence before moving on
ANSWER_HOLD_SECS=1.0
HOLD_MIN_WORDS=12
# Clarification limits (anti hint-fishing; flagged for the recruiter)
MAX_REPHRASES_PER_INTERVIEW=3
REPEATS_BEFORE_BEST_ATTEMPT=3
FLAG_REPEATS_TOTAL=5
# Asking to go back to an earlier question is declined; flagged from this many
FLAG_GO_BACK_REQUESTS=2
# Cut in after this share of a new question = early answer to it
EARLY_ANSWER_FRACTION=0.6
# Stop and Start within this many seconds = rejoin the same interview
RESUME_MAX_AGE_SECS=900
